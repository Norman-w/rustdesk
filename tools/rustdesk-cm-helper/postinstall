#!/bin/sh
set -eu

app_path="${NORMAN_RUSTDESK_APP_PATH:-}"
if [ -z "$app_path" ]; then
  for candidate in \
    "/Applications/NormanRemoteDesktop.app" \
    "/Applications/NormanRemoteDesktop-RustDesk-Test.app"; do
    if [ -f "$candidate/Contents/Info.plist" ]; then
      app_path="$candidate"
      break
    fi
  done
fi
app_info="$app_path/Contents/Info.plist"
app_library="$app_path/Contents/Frameworks/liblibrustdesk.dylib"
support_root="/Library/Application Support/NormanRemoteDesktop/cm-helper-support"
virtual_input_driver="/Library/Audio/Plug-Ins/HAL/NormanRemoteMic.driver"
virtual_output_driver="/Library/Audio/Plug-Ins/HAL/NormanRemoteAudio.driver"
agent_label="com.norman.remotedesktop-cm-no-ui"
helper_relative="Library/Application Support/NormanRemoteDesktop/cm-helper"
agent_name="$agent_label.plist"
helper_version="1.3.0"
norman_device_name="Norman 手机麦克风"
norman_audio_output_name="Norman Remote Audio"

app_executable=""
for candidate in \
  "$app_path/Contents/MacOS/NormanRemoteDesktop"; do
  if [ -x "$candidate" ]; then
    app_executable="$candidate"
    break
  fi
done

if [ ! -f "$app_info" ] || [ ! -x "$app_executable" ] || [ ! -f "$app_library" ]; then
  echo "NormanRemoteDesktop 1.4.10 is not installed at $app_path."
  exit 1
fi

bundle_identifier=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app_info" 2>/dev/null || true)
bundle_version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app_info" 2>/dev/null || true)
if [ "$bundle_identifier" != "com.carriez.NormanRemoteDesktop" ]; then
  echo "The installed application is not the expected NormanRemoteDesktop bundle."
  exit 1
fi
if [ "$bundle_version" != "1.4.10" ]; then
  echo "This helper package requires NormanRemoteDesktop 1.4.10; found $bundle_version."
  exit 1
fi
if ! { /usr/bin/strings -a "$app_executable"; /usr/bin/strings -a "$app_library"; } |
    /usr/bin/grep -q -- '--cm'; then
  echo "The installed NormanRemoteDesktop executable does not expose the official CM entry point."
  exit 1
fi

# Keep PackageKit completely outside the TCC flow. Running either public TCC
# command from a package script can make macOS attribute a permission prompt to
# Installer, which would ask the user to quit/reopen the installer mid-install.
# NormanRemoteDesktop.app owns --tcc-status/--repair-tcc after the app is opened.

console_user=$(/usr/bin/stat -f '%Su' /dev/console)
if [ -z "$console_user" ] || [ "$console_user" = "root" ]; then
  echo "A logged-in macOS user is required to install the user-level helper."
  exit 1
fi
console_uid=$(/usr/bin/id -u "$console_user")
console_home=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory | /usr/bin/awk '{print $2}')
case "$console_home" in
  /*) ;;
  *)
    echo "Unable to resolve the logged-in user's home directory."
    exit 1
    ;;
esac

for support_file in run-cm-helper.sh remote-mic-config.sh repair-tcc.sh audio-config-default.plist; do
  if [ ! -f "$support_root/$support_file" ]; then
    echo "The unified helper payload is incomplete: $support_file is missing."
    exit 1
  fi
done
if [ ! -x "$support_root/bin/norman-remote-mic-device-probe" ]; then
  echo "The unified helper payload is incomplete: device probe is missing."
  exit 1
fi

driver_info="$virtual_input_driver/Contents/Info.plist"
driver_executable="$virtual_input_driver/Contents/MacOS/NormanRemoteMic"
if [ ! -f "$driver_info" ] || [ ! -x "$driver_executable" ]; then
  echo "The unified helper payload is incomplete: Norman virtual microphone is missing."
  exit 1
fi
/usr/bin/plutil -lint "$driver_info" >/dev/null
driver_identifier=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$driver_info" 2>/dev/null || true)
if [ "$driver_identifier" != "com.norman.remotedesktop.virtual-mic" ]; then
  echo "The installed Norman virtual microphone has an unexpected bundle identifier."
  exit 1
fi
driver_signature="unsigned"
if /usr/bin/codesign --verify --deep "$virtual_input_driver" >/dev/null 2>&1; then
  driver_signature="signed"
fi

audio_driver_info="$virtual_output_driver/Contents/Info.plist"
audio_driver_executable="$virtual_output_driver/Contents/MacOS/NormanRemoteAudio"
if [ ! -f "$audio_driver_info" ] || [ ! -x "$audio_driver_executable" ]; then
  echo "The unified helper payload is incomplete: Norman Remote Audio output is missing."
  exit 1
fi
/usr/bin/plutil -lint "$audio_driver_info" >/dev/null
audio_driver_identifier=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$audio_driver_info" 2>/dev/null || true)
if [ "$audio_driver_identifier" != "com.norman.remotedesktop.virtual-audio" ]; then
  echo "The installed Norman Remote Audio output has an unexpected bundle identifier."
  exit 1
fi
audio_driver_signature="unsigned"
if /usr/bin/codesign --verify --deep "$virtual_output_driver" >/dev/null 2>&1; then
  audio_driver_signature="signed"
fi

helper_root="$console_home/$helper_relative"
agent_directory="$console_home/Library/LaunchAgents"
agent_path="$agent_directory/$agent_name"
log_directory="$console_home/Library/Logs/NormanRemoteDesktop"
runner_path="$helper_root/run-cm-helper.sh"
config_path="$helper_root/audio-config.plist"
manifest_path="$helper_root/manifest.json"
heartbeat_path="$helper_root/heartbeat.json"
domain="gui/$console_uid"

/bin/mkdir -p "$helper_root/bin" "$log_directory"

# The visible NormanRemoteDesktop.app owns connection management.  The package
# only installs the CoreAudio HAL component and app-managed audio state.  Remove
# any older Norman CM LaunchAgent so an upgrade cannot leave a second listener
# on the `_cm` IPC endpoint.
/bin/launchctl bootout "$domain/$agent_label" 2>/dev/null || true
/bin/rm -f "$agent_path"
/bin/rm -f "$runner_path" "$helper_root/remote-mic-config.sh" "$helper_root/repair-tcc.sh"
/bin/rm -f "$heartbeat_path" "$helper_root/audio-status.json"
/bin/rm -f "$helper_root"/audio-state-* "$helper_root"/tcc-state-* "$helper_root"/virtual-input-*

/bin/cp "$support_root/bin/norman-remote-mic-device-probe" "$helper_root/bin/norman-remote-mic-device-probe"
if [ ! -f "$config_path" ]; then
  /bin/cp "$support_root/audio-config-default.plist" "$config_path"
else
  # Existing 1.3.0 installs were shipped with the optional route disabled.
  # Migrate only that untouched default so a first normal installation becomes
  # usable without asking the user to run a shell script. Explicit device
  # choices and explicit disables remain untouched.
  config_enabled=$(/usr/libexec/PlistBuddy -c 'Print :enabled' "$config_path" 2>/dev/null || true)
  config_device=$(/usr/libexec/PlistBuddy -c 'Print :outputDeviceName' "$config_path" 2>/dev/null || true)
  if [ "$config_enabled" != "true" ] && [ -z "$config_device" ]; then
    /usr/bin/plutil -replace enabled -bool YES "$config_path"
    /usr/bin/plutil -replace outputDeviceName -string "$norman_device_name" "$config_path"
    /usr/bin/plutil -replace loopbackVerified -bool YES "$config_path"
  fi
fi
/bin/chmod 755 "$helper_root/bin/norman-remote-mic-device-probe"
/usr/bin/plutil -lint "$config_path" >/dev/null
/usr/bin/printf '%s\n' 'managed-by-NormanRemoteDesktop.app' > "$helper_root/app-managed.marker"

config_enabled=$(/usr/libexec/PlistBuddy -c 'Print :enabled' "$config_path" 2>/dev/null || true)
config_device=$(/usr/libexec/PlistBuddy -c 'Print :outputDeviceName' "$config_path" 2>/dev/null || true)
config_loopback=$(/usr/libexec/PlistBuddy -c 'Print :loopbackVerified' "$config_path" 2>/dev/null || true)
virtual_input_state="bundle-installed"
probe_output=""
virtual_input_channels=0
virtual_output_channels=0
virtual_audio_output_state="pending-reload"
if [ -x "$helper_root/bin/norman-remote-mic-device-probe" ]; then
  # The phone stream is consumed from the virtual device's input side. The
  # output side is checked separately below because it is RustDesk's receiver
  # sink, not the microphone presented to other Mac applications.
  probe_output=$("$helper_root/bin/norman-remote-mic-device-probe" --check-input "$norman_device_name" 2>/dev/null || true)
  virtual_input_channels=$(echo "$probe_output" | /usr/bin/sed -n 's/.*input_channels=\([0-9][0-9]*\).*/\1/p' | /usr/bin/head -n 1)
  virtual_output_channels=$(echo "$probe_output" | /usr/bin/sed -n 's/.*output_channels=\([0-9][0-9]*\).*/\1/p' | /usr/bin/head -n 1)
  [ -n "$virtual_input_channels" ] || virtual_input_channels=0
  [ -n "$virtual_output_channels" ] || virtual_output_channels=0
  if echo "$probe_output" | /usr/bin/grep -Eq 'found=1.*input_channels=[1-9][0-9]*'; then
    virtual_input_state="available"
  else
    virtual_input_state="pending-reload"
  fi
  audio_probe_output=$("$helper_root/bin/norman-remote-mic-device-probe" --check-input "$norman_audio_output_name" 2>/dev/null || true)
  if echo "$audio_probe_output" | /usr/bin/grep -Eq 'found=1.*input_channels=[1-9][0-9]*.*output_channels=[1-9][0-9]*'; then
    virtual_audio_output_state="available"
  fi
fi

audio_state="not-configured"
audio_route="speaker-only"
other_apps_input="not-available"
if [ "$config_enabled" = "true" ] && [ "$config_device" = "$norman_device_name" ] &&
    [ "$config_loopback" = "true" ]; then
  if ! { /usr/bin/strings -a "$app_executable"; /usr/bin/strings -a "$app_library"; } |
      /usr/bin/grep -q -- 'NORMAN_REMOTE_MIC_OUTPUT_DEVICE'; then
    audio_state="requires-patched-rustdesk"
  elif [ "$virtual_input_state" != "available" ]; then
    audio_state="unavailable"
    audio_route="virtual-output"
  elif [ "$virtual_output_channels" -le 0 ]; then
    audio_state="input-only"
    audio_route="virtual-output"
    other_apps_input="available"
  else
    audio_state="ready"
    audio_route="virtual-output"
    other_apps_input="available"
  fi
fi

for old_marker in "$helper_root"/audio-state-* "$helper_root"/virtual-input-* "$helper_root"/virtual-output-*; do
  if [ -e "$old_marker" ]; then
    /bin/rm -f "$old_marker"
  fi
done
: > "$helper_root/audio-state-$audio_state"
: > "$helper_root/virtual-input-$virtual_input_state"
: > "$helper_root/virtual-output-$virtual_audio_output_state"

/usr/bin/printf '%s\n' \
  "{\"schemaVersion\":5,\"state\":\"installed\",\"helperKind\":\"norman-remotedesktop-app-managed-components\",\"helperVersion\":\"$helper_version\",\"baseBundleIdentifier\":\"$bundle_identifier\",\"baseVersion\":\"$bundle_version\",\"launchAgentLabel\":\"\",\"purpose\":\"NormanRemoteDesktop.app owns TCC, connection management, and service orchestration; this package installs the CoreAudio HAL and app-managed audio data.\",\"components\":{\"cm\":{\"state\":\"app-managed\"},\"audio\":{\"state\":\"$audio_state\",\"route\":\"$audio_route\",\"virtualInput\":\"$virtual_input_state\",\"virtualOutput\":\"$virtual_audio_output_state\",\"driverSignature\":\"$driver_signature\",\"audioDriverSignature\":\"$audio_driver_signature\",\"otherAppsInput\":\"$other_apps_input\"}}}" \
  > "$manifest_path"

/usr/sbin/chown -R "$console_user":staff "$helper_root" "$log_directory"
/bin/chmod 644 "$config_path" "$manifest_path"
/usr/sbin/chown "$console_user":staff "$manifest_path"

if ! { /usr/bin/strings -a "$app_executable"; /usr/bin/strings -a "$app_library"; } |
    /usr/bin/grep -q -- 'NORMAN_REMOTE_MIC_OUTPUT_DEVICE'; then
  echo "NormanRemoteDesktop app-managed components are ready; Norman virtual microphone is $driver_signature, but audio routing needs the patched NormanRemoteDesktop binary."
else
  echo "NormanRemoteDesktop app-managed components are ready; audio state=$audio_state, virtual input=$virtual_input_state, virtual output=$virtual_audio_output_state, driver=$driver_signature/$audio_driver_signature."
fi
if [ "$driver_signature" != "signed" ]; then
  echo "Warning: this package contains an unsigned development HAL plug-in. A signed/notarized build is required for a production installation."
fi
echo "The package does not change the default audio devices. CoreAudio may need a user-approved reload or logout/restart before Norman 手机麦克风 appears."
